# llmgate 环境变量示例：cp .env.example .env 后按需修改
# 管理端令牌（必填；用: openssl rand -hex 24 生成；改后重启即用新令牌登录）
LGM_ADMIN_TOKEN=
# API Key 加密种子（32 字节 hex，可用: openssl rand -hex 32）；留空则首次启动自动生成并保存
LGM_ENCRYPT_SEED=
# 监听地址（本地与容器保持一致）
LGM_HTTP_ADDR=:3210
# SQLite 路径（仅本地 dev 生效；Docker 内固定为 /data/llmgate.db）
LGM_DB_PATH=./data/llmgate.db
# 开放网关前缀（默认 /，如 "/" → /v1/chat/completions）
LGM_GATEWAY_PREFIX=/
# gin 日志模式：debug / release
LGM_LOG_LEVEL=release
# 上游出站代理（绕过网络过滤；支持 socks5:// / socks5h:// / http:// / https://；直连则留空）
LGM_PROXY=socks5://127.0.0.1:7891
# 应用时区（仪表盘"今日"统计 + SQLite localtime）
LGM_TZ=Asia/Shanghai